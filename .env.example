# Local development defaults (no secrets). Nothing loads this file (or a root
# .env) automatically: the Rust binaries read only the process environment.
# To use these values, export them in your shell first, e.g. in bash:
#   set -a && . ./.env.example && set +a
# (or copy to .env, edit, and source that instead; .env is git-ignored).
# API_URL is read by Next.js, which only auto-loads web/.env*; put overrides
# in web/.env.local or export it before `npm --prefix web run dev`.
# DATABASE_URL matches compose.yaml.
DATABASE_URL=postgres://mex:mex@127.0.0.1:5432/mex_scrape
# Address the api binary listens on.
API_ADDR=127.0.0.1:8080
# User sessions (api). Cookies are Secure unless this is exactly `false`;
# set it to false only for local plain-http hosts other than localhost.
# SESSION_COOKIE_SECURE=true
# Origins allowed to send mutating requests (CSRF check), comma-separated.
# APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Rate limits on user routes (requests per minute and back-to-back burst).
# Signed-in users by plan; ANON is per client IP (sign-up, sign-in).
# Defaults shown.
# RATE_LIMIT_FREE_PER_MINUTE=60
# RATE_LIMIT_FREE_BURST=30
# RATE_LIMIT_PRO_PER_MINUTE=300
# RATE_LIMIT_PRO_BURST=100
# RATE_LIMIT_ANON_PER_MINUTE=20
# RATE_LIMIT_ANON_BURST=10
# Header holding the client IP for the ANON limit, e.g. x-real-ip. Set it only
# when a front proxy (nginx/Caddy, in front of Next.js) OVERWRITES that header
# on every request: the Next.js /backend rewrite forwards client-sent headers
# verbatim, so otherwise clients can forge it. Must hold exactly one IP; else
# the TCP peer is used. Unset: the peer is the Next server, so all anonymous
# visitors share one bucket (the api warns at startup).
# TRUST_PROXY_HEADERS=true is a deprecated alias for CLIENT_IP_HEADER=x-real-ip.
# CLIENT_IP_HEADER=x-real-ip
# Bearer token for the api's admin routes (GET /admin/brightdata/access).
# At least 16 bytes; unset or shorter disables them (503). They also need
# DATABASE_URL. Never commit a real value.
# ADMIN_API_TOKEN=
# AI assistant (docs/modules/agent.md, ADR 0013). The api talks to the
# gg-agent sidecar (services/agent); all three api values must be set, else
# /assistant/chat answers 503. AGENT_URL must use a host name (IP literals are
# refused by the private-service transport policy). Never commit real values.
# AGENT_URL=http://localhost:8090
# Shared bearer between api and sidecar, at least 32 characters.
# AGENT_SERVICE_TOKEN=
# Key for the per-chat tool grants (HMAC-SHA256), at least 32 bytes. api only.
# AGENT_GRANT_KEY=
# Daily assistant tokens per tenant, by plan. Defaults shown.
# AGENT_DAILY_TOKENS_FREE=50000
# AGENT_DAILY_TOKENS_PRO=500000
# Sidecar (services/agent) settings. Defaults shown where there is one.
# AGENT_ADDR=127.0.0.1:8090
# AGENT_API_URL=http://127.0.0.1:8080
# Model provider: anthropic or openai (palsu is the test fake and also needs
# AGENT_ALLOW_FAKE_PROVIDER=true; refused when NODE_ENV=production).
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=
# The provider API key: a sidecar-only secret, never logged.
# AGENT_PROVIDER_API_KEY=
# AGENT_MAX_TURNS=6
# AGENT_TOOL_TIMEOUT_MS=10000
# AGENT_RUN_TIMEOUT_MS=60000
# AGENT_MAX_OUTPUT_TOKENS=1024
# AGENT_MAX_TOOL_RESULT_CHARS=16000
# seed_e2e (web e2e tests) only seeds a DATABASE_URL on localhost, 127.0.0.1
# or ::1. Set this to exactly `true` to seed another TEST database; never a
# real one (it creates an account with a known password).
# E2E_ALLOW_REMOTE_DB=false
# Where the Next.js server proxies /backend/* requests. Read by `next dev` at
# startup, but for production it is baked in by `npm --prefix web run build`:
# `next start` ignores a runtime API_URL, so set it before building.
API_URL=http://127.0.0.1:8080
# Server secrets, read by the worker at start-up (never commit real values).
# Leave them commented out when unused: a variable that is set but empty
# stops the worker.
# Bright Data: how to get both values, step by step: docs/setup/brightdata.md
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_UNLOCKER_ZONE=
# Optional Browser API zone (remote Chrome over CDP), only for stores whose
# pages need JavaScript (ADR 0007, docs/modules/retailers.md).
# BRIGHTDATA_BROWSER_ZONE=
# SPAPI_LWA_CLIENT_ID=
# SPAPI_LWA_CLIENT_SECRET=
# SPAPI_REFRESH_TOKEN=
# MODEL_PROVIDER_API_KEY=
# Demo mode (local only, ADR 0016): set to exactly `true` to serve the
# products of config/demo_catalog.json through a fake Bright Data connector
# (store pages and Amazon records) with no network calls; Bright Data and
# SP-API credentials are then ignored. The worker refuses it unless
# DATABASE_URL is on localhost/127.0.0.1/::1, and runs only the searches of
# the demo account (demo@example.com, created by seed_demo). It needs no
# connector flag and raises the default Bright Data caps (set caps still
# win) and SEARCH_MAX_OFFERS_PER_RETAILER to 10, so a keyword-group search
# covers every demo listing. Seed first (it queues one search per keyword
# group): docs/modules/db/demo-data.md. For the assistant in a demo, run the
# sidecar with AGENT_PROVIDER=palsu and AGENT_ALLOW_FAKE_PROVIDER=true.
# DEMO_DATA=false
# Retailer parse health (worker): warn when an adapter's parse success rate
# over its last 100 pages drops below the threshold (0..1), once at least
# MIN_SAMPLES pages were parsed. Defaults shown.
# RETAILER_PARSE_ALERT_THRESHOLD=0.8
# RETAILER_PARSE_ALERT_MIN_SAMPLES=20
# Worker jobs, schedules and caps (docs/modules/worker.md). All optional;
# defaults shown. A malformed or out-of-range value stops the worker.
# Schedules are 5-field cron expressions in UTC.
# REFRESH_CRON=0 */6 * * *
# CATEGORY_BROWSE_CRON=30 3 * * *
# Queue: visibility timeout (seconds), reads before dead-lettering, idle poll.
# JOB_VISIBILITY_SECS=900
# JOB_MAX_ATTEMPTS=5
# JOB_POLL_IDLE_MS=2000
# Bright Data per-tenant daily caps and per-run item cap.
# BRIGHTDATA_MAX_RUNS_PER_TENANT_PER_DAY=20
# BRIGHTDATA_MAX_ITEMS_PER_TENANT_PER_DAY=500
# BRIGHTDATA_MAX_ITEMS_PER_RUN=50
# Amazon (SP-API and its Bright Data fallback) requests per tenant per day.
# AMAZON_MAX_REQUESTS_PER_TENANT_PER_DAY=1000
# Job sizes (SEARCH_MAX_OFFERS_PER_RETAILER defaults to 10 when DEMO_DATA=true).
# SEARCH_MAX_OFFERS_PER_RETAILER=3
# REFRESH_BATCH_SIZE=25
# CATEGORY_MAX_PAGES_PER_RUN=4
# ROI extra costs per unit, in centavos.
# ROI_PREP_FEE_CENTAVOS=0
# ROI_SHIPPING_CENTAVOS=0
# Cost estimate rates for the metrics (micro-USD).
# BRIGHTDATA_UNLOCKER_MICROUSD_PER_REQUEST=1500
# BRIGHTDATA_BROWSER_MICROUSD_PER_MB=8000
# Category listing URLs for stores without keyword search (ADR 0008).
# CATEGORY_LISTINGS_PATH=config/category_listings.json
