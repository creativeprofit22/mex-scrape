# Local development defaults (no secrets). Nothing loads this file (or a root
# .env) automatically: the Rust binaries read only the process environment.
# To use these values, export them in your shell first, e.g. in bash:
#   set -a && . ./.env.example && set +a
# (or copy to .env, edit, and source that instead; .env is git-ignored).
# API_URL is read by Next.js, which only auto-loads web/.env*; put overrides
# in web/.env.local or export it before `npm --prefix web run dev`.
# DATABASE_URL matches compose.yaml.
DATABASE_URL=postgres://mex:mex@127.0.0.1:5432/mex_scrape
# Address the api binary listens on.
API_ADDR=127.0.0.1:8080
# Bearer token for the api's admin routes (GET /admin/brightdata/access).
# At least 16 bytes; unset or shorter disables them (503). They also need
# DATABASE_URL. Never commit a real value.
# ADMIN_API_TOKEN=
# Where the Next.js server proxies /backend/* requests. Read by `next dev` at
# startup, but for production it is baked in by `npm --prefix web run build`:
# `next start` ignores a runtime API_URL, so set it before building.
API_URL=http://127.0.0.1:8080
# Server secrets, read by the worker at start-up (never commit real values).
# Leave them commented out when unused: a variable that is set but empty
# stops the worker.
# Bright Data: how to get both values, step by step: docs/setup/brightdata.md
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_UNLOCKER_ZONE=
# Optional Browser API zone (remote Chrome over CDP), only for stores whose
# pages need JavaScript (ADR 0007, docs/modules/retailers.md).
# BRIGHTDATA_BROWSER_ZONE=
# SPAPI_LWA_CLIENT_ID=
# SPAPI_LWA_CLIENT_SECRET=
# SPAPI_REFRESH_TOKEN=
# MODEL_PROVIDER_API_KEY=
# Retailer parse health (worker): warn when an adapter's parse success rate
# over its last 100 pages drops below the threshold (0..1), once at least
# MIN_SAMPLES pages were parsed. Defaults shown.
# RETAILER_PARSE_ALERT_THRESHOLD=0.8
# RETAILER_PARSE_ALERT_MIN_SAMPLES=20
