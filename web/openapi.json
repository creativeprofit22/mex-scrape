{
  "openapi": "3.1.0",
  "info": {
    "title": "mex-scrape API",
    "description": "Backend API for mex-scrape.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/admin/brightdata/access": {
      "get": {
        "summary": "Bright Data access outcomes per retailer host (admin only).",
        "operationId": "brightdata_access",
        "responses": {
          "200": {
            "description": "Outcome counts per host",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RetailerAccessCounts"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong bearer token"
          },
          "500": {
            "description": "Counts could not be read"
          },
          "503": {
            "description": "Admin API is not configured"
          }
        },
        "security": [
          {
            "admin_bearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Report that the API process is alive (does not check the database).",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "API is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/products/{asin}/price-stats": {
      "get": {
        "summary": "Lowest, highest and average retailer price over 30, 90 and 365 days for\nevery retailer listing matched (accepted) to an Amazon product.",
        "operationId": "product_price_stats",
        "parameters": [
          {
            "name": "asin",
            "in": "path",
            "description": "Amazon ASIN (10 letters or digits)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Price stats per listing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceStatsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Not a valid ASIN"
          },
          "500": {
            "description": "Price history could not be read"
          },
          "503": {
            "description": "Price history is not configured"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "description": "Liveness response for `GET /health`.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `\"ok\"` when the process is serving requests."
          }
        }
      },
      "ListingPriceStatsResponse": {
        "type": "object",
        "description": "Price windows for one retailer listing matched to the product.",
        "required": [
          "retailer",
          "retailer_sku",
          "windows"
        ],
        "properties": {
          "retailer": {
            "type": "string",
            "description": "Retailer id, e.g. `walmart_mx`."
          },
          "retailer_sku": {
            "type": "string",
            "description": "The retailer's product id."
          },
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceWindowResponse"
            },
            "description": "30, 90 and 365-day windows, shortest first."
          }
        }
      },
      "PriceStatsResponse": {
        "type": "object",
        "description": "Price stats for an Amazon product across matched retailer listings.",
        "required": [
          "asin",
          "as_of_ms",
          "listings"
        ],
        "properties": {
          "as_of_ms": {
            "type": "integer",
            "format": "int64",
            "description": "Instant every window ends at (epoch milliseconds)."
          },
          "asin": {
            "type": "string",
            "description": "The Amazon product."
          },
          "listings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListingPriceStatsResponse"
            },
            "description": "One entry per accepted listing, sorted by retailer then SKU."
          }
        }
      },
      "PriceWindowResponse": {
        "type": "object",
        "description": "Low, high and average price over one window. Amounts are integer\ncentavos; they are absent when no in-stock price was observed.",
        "required": [
          "days",
          "observations"
        ],
        "properties": {
          "average_centavos": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Mean price (rounded half up), in centavos."
          },
          "days": {
            "type": "integer",
            "format": "int32",
            "description": "Window length in days (30, 90 or 365).",
            "minimum": 0
          },
          "high_centavos": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Highest price, in centavos."
          },
          "low_centavos": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Lowest price, in centavos."
          },
          "observations": {
            "type": "integer",
            "format": "int32",
            "description": "Observations counted (out-of-stock prices are not counted).",
            "minimum": 0
          }
        }
      },
      "RetailerAccessCounts": {
        "type": "object",
        "description": "Access outcomes for one retailer host.",
        "required": [
          "retailer",
          "host",
          "ok",
          "blocked_needs_kyc",
          "skipped_robots",
          "failed"
        ],
        "properties": {
          "blocked_needs_kyc": {
            "type": "integer",
            "format": "int64",
            "description": "Refusals that need KYC (`blocked_needs_kyc`)."
          },
          "failed": {
            "type": "integer",
            "format": "int64",
            "description": "Other failures."
          },
          "host": {
            "type": "string",
            "description": "Target host."
          },
          "ok": {
            "type": "integer",
            "format": "int64",
            "description": "Pages fetched."
          },
          "retailer": {
            "type": "string",
            "description": "Retailer id from the registry, or the host when it is not registered."
          },
          "skipped_robots": {
            "type": "integer",
            "format": "int64",
            "description": "URLs skipped because robots.txt disallows them."
          }
        }
      }
    },
    "securitySchemes": {
      "admin_bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
